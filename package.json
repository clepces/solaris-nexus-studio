{
  "name": "solaris-nexus-studio",
  "version": "0.4.1-alpha",
  "private": true,
  "description": "Enterprise UI & TypeScript Frontend for Solaris Nexus Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ts && npm run build:sass",
    "build:ts": "esbuild src/frontend/main.ts --bundle --outfile=public/assets/js/bundle.js --format=esm --target=esnext --tsconfig=./tsconfig.json",
    "build:sass": "sass src/interface/scss/main.scss public/assets/css/main-theme.css --no-source-map --style=compressed",
    "watch:sass": "sass --watch src/interface/scss/main.scss:public/assets/css/main-theme.css",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.21.5",
    "sass": "^1.77.8",
    "typescript": "^7.0.2",
    "vite": "^5.4.2"
  }
}
