# ==============================================================================
# SOLARIS NEXUS STUDIO - CONFIGURACIÓN DE ENTORNO SEGURA
# Empresa: Clepces org. ltd
# ==============================================================================

# Entorno de ejecución: development | production | testing
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/Clepces/projects/solaris-nexus-studio/public

# Motor de Base de Datos: sqlite | mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solaris_nexus
DB_USER=root
DB_PASS=

# Rutas del Motor Ironclad Games (Sins of a Solar Empire: Rebellion)
SINS_INSTALL_PATH=C:/Games/Sins of a Solar Empire Rebellion
SINS_MODS_PATH=Documents/My Games/Ironclad Games/Sins of a Solar Empire Rebellion/Mods-Rebellion v1.85

# Sistema de Registro y Auditoría
LOG_LEVEL=info
LOG_DIR=storage/logs
